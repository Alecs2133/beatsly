# URL-ul către instanța ta de Supabase (ex: https://xxx.supabase.co)
VITE_SUPABASE_URL=

# Cheia publică (anon key) pentru Supabase
VITE_SUPABASE_ANON_KEY=

# (Opțional) Token-ul pentru HuggingFace API, folosit pentru generarea de muzică AI
# Dacă este lăsat gol, aplicația va folosi un fișier fallback (test_beat.wav)
VITE_HF_API_TOKEN=
