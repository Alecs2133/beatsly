# URL-ul către instanța ta de Supabase (ex: https://xxx.supabase.co)
VITE_SUPABASE_URL=

# Cheia publică (anon key) pentru Supabase.
# E singura cheie care are voie să ajungă în client — protecția reală
# vine din RLS, nu din secretul cheii.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# ATENȚIE: nu adăuga aici chei de API pentru servicii terțe.
#
# Orice variabilă cu prefixul VITE_ este inclusă în bundle-ul JavaScript și
# deci în installerul distribuit public. Oricine descarcă aplicația o poate
# extrage în câteva secunde.
#
# Tokenul HuggingFace s-a mutat în edge function-ul `generate-audio`, unde se
# configurează ca secret de proiect:
#   supabase secrets set HF_API_TOKEN=hf_xxx
# ---------------------------------------------------------------------------
