{
    "productName": "beatsly",
    "version": "../package.json",
    "identifier": "com.beatsly.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [{
            "title": "beatsly",
            "width": 1280,
            "height": 720
        }],
        "security": {
            "csp": {
                "default-src": "'self'",
                "script-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "font-src": "'self' data:",
                "img-src": "'self' data: blob: asset: http://asset.localhost",
                "media-src": "'self' data: blob: asset: http://asset.localhost https://lhoqhzigptnyhwgjqpsc.supabase.co",
                "connect-src": "'self' data: blob: asset: http://asset.localhost ipc: http://ipc.localhost https://lhoqhzigptnyhwgjqpsc.supabase.co wss://lhoqhzigptnyhwgjqpsc.supabase.co http://localhost:1420 ws://localhost:1420",
                "frame-src": "'none'",
                "object-src": "'none'",
                "base-uri": "'self'",
                "form-action": "'none'"
            },
            "devCsp": {
                "default-src": "'self'",
                "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
                "style-src": "'self' 'unsafe-inline'",
                "font-src": "'self' data:",
                "img-src": "'self' data: blob: asset: http://asset.localhost",
                "media-src": "'self' data: blob: asset: http://asset.localhost https://lhoqhzigptnyhwgjqpsc.supabase.co",
                "connect-src": "'self' data: blob: asset: http://asset.localhost ipc: http://ipc.localhost https://lhoqhzigptnyhwgjqpsc.supabase.co wss://lhoqhzigptnyhwgjqpsc.supabase.co http://localhost:1420 ws://localhost:1420 ws://localhost:1421",
                "frame-src": "'none'",
                "object-src": "'none'",
                "base-uri": "'self'",
                "form-action": "'none'"
            },
            "assetProtocol": {
                "enable": true,
                "scope": []
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
