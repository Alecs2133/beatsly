{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "dialog:default",
        "drag:default",
        "fs:allow-write-file",
        {
            "identifier": "http:default",
            "allow": [
                { "url": "https://lhoqhzigptnyhwgjqpsc.supabase.co/*" }
            ]
        },
        {
            "identifier": "shell:allow-open",
            "allow": [
                { "url": "https://*.stripe.com/*" },
                { "url": "https://stripe.com/*" }
            ]
        }
    ]
}
