{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "dialog:default",
        "drag:default",
        {
            "identifier": "http:default",
            "allow": [{ "url": "https://api-inference.huggingface.co/*" }]
        },
        {
            "identifier": "shell:allow-execute",
            "allow": [{
                "name": "bin/analyzer",
                "sidecar": true,
                "args": true
            }]
        }
    ]
}